{
  "name": "worldchat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run icons && tsc -b && vite build",
    "build:test": "npm run icons && tsc -b && vite build --mode test",
    "preview": "vite preview --host 0.0.0.0",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
